#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt { flavor = "balanced"; };

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
&none  &kp Q        &kp W        &kp E           &kp R       &kp T          &kp Y      &kp U            &kp I       &kp O        &kp P            &none
&none  &lt 5 A      &mt LCTRL S  &mt LEFT_ALT D  &mt LCMD F  &lt 6 G        &kp H      &mt RIGHT_WIN J  &mt LALT K  &mt LCTRL L  &lt 4 SEMICOLON  &none
&none  &mt LSHFT Z  &kp X        &kp C           &lt 6 V     &lt 3 B        &kp N      &kp M            &kp COMMA   &kp DOT      &mt RSHFT SLASH  &none
                                 &kp BACKSPACE   &mo 1       &lt 3 SPACE    &kp ENTER  &lt 2 SQT
            >;
        };

        Lower {
            label = "Lower";
            bindings = <
&trans  &kp NUMBER_1       &kp NUMBER_2  &kp N3        &kp N4         &kp N5          &kp N6        &kp N7         &kp N8     &kp N9    &kp N0      &none
&none   &kp LEFT_BRACKET   &kp DOWN      &kp LS(PLUS)  &kp MINUS      &kp LS(LPAR)    &kp LS(RPAR)  &kp MINUS      &kp EQUAL  &kp LBKT  &kp RBKT    &none
&none   &kp LS(LESS_THAN)  &trans        &kp EQUAL     &kp LS(UNDER)  &kp LS(LBRC)    &kp LS(RBRC)  &kp SQT        &none      &none     &kp LS(GT)  &none
                                         &none         &none          &none           &kp ENTER     &kp LG(SPACE)
            >;
        };

        Raise {
            label = "Raise";
            bindings = <
&none  &kp EXCL   &kp AT       &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR       &none
&none  &kp GRAVE  &none        &kp F1    &kp F2    &kp F3       &kp F4     &kp F5    &kp F6           &none     &kp PIPE       &none
&none  &kp TILDE  &bootloader  &kp F7    &kp F8    &kp F9       &kp F10    &kp F11   &kp F12          &none     &kp BACKSLASH  &none
                               &none     &none     &none        &none      &none
            >;
        };

        Move {
            label = "move";
            bindings = <
&none  &kp ESC    &none      &none     &none         &kp INSERT    &kp HOME        &kp PG_DN   &kp PG_UP     &kp END    &kp ESC    &none
&none  &none      &kp LCTRL  &kp LALT  &kp LEFT_GUI  &none         &kp LEFT_ARROW  &kp DOWN    &kp UP_ARROW  &kp RIGHT  &none      &none
&none  &kp LSHFT  &none      &none     &none         &kp DEL       &kp BACKSPACE   &kp DELETE  &none         &none      &kp RSHFT  &none
                             &none     &mo 7         &none         &kp TAB         &kp ENTER
            >;
        };

        Number {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &kp PLUS   &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &kp MINUS  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &kp STAR   &kp N1  &kp N2  &kp N3  &trans  &trans
                        &trans  &trans  &kp EQUAL    &kp FSLH   &kp N0
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &kp KP_PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &kp KP_SUBTRACT  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &kp KP_ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans
                        &trans  &trans  &kp KP_EQUAL    &kp KP_DIVIDE    &kp KP_N0
            >;
        };

        Mouse {
            bindings = <
&none  &none       &none  &none      &none      &none        &none  &mkp MB4   &mkp MB5   &none      &none  &none
&none  &none       &none  &none      &none      &none        &none  &mkp LCLK  &mkp RCLK  &mkp MCLK  &none  &none
&none  &kp LSHIFT  &none  &none      &none      &mo 8        &none  &none      &none      &none      &none  &none
                          &mkp MCLK  &mkp LCLK  &mkp RCLK    &none  &none
            >;
        };

        Keyboard_FN {
            bindings = <
&none  &kp KP_NUMLOCK  &none  &none  &none  &bt BT_CLR    &none  &out OUT_BLE  &out OUT_USB  &none         &none        &none
&none  &kp CAPSLOCK    &none  &none  &none  &none         &none  &bt BT_SEL 3  &bt BT_SEL 4  &none         &none        &none
&none  &none           &none  &none  &none  &none         &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bootloader  &none
                              &none  &none  &none         &none  &none
            >;
        };

        MouseSnip {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };
    };
};
